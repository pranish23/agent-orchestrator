# Environment
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/orchestrator
DATABASE_SYNC_URL=postgresql://postgres:postgres@db:5432/orchestrator

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Settings
LLM_PROVIDER=openai  # openai or gemini
###############
# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# OR
# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001
###############
# Rate Limiting
RATE_LIMIT_QUERIES_PER_HOUR=100

# Cache TTL (seconds)
CACHE_TTL_EMBEDDINGS=3600
CACHE_TTL_INTENT=3600
CACHE_TTL_CONTEXT=86400

# Sync Settings
SYNC_INTERVAL_MINUTES=15

# Google OAuth (for production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
